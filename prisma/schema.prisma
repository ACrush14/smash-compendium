generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Franchise {
  id           String        @id @default(cuid())
  name         String        @unique
  svgIconUrl   String?
  fighters     Fighter[]
  stages       Stage[]
  musicTracks  Music[]
  collectibles Collectible[] @relation("CollectibleFranchise")
}

model Fighter {
  id                 String        @id @default(cuid())
  rosterNumber       String
  name               String        @unique
  franchiseId        String
  imageUrl           String?
  selectAnimationUrl String?       @db.Text
  // i18n curadoria
  curatorOverviewEn   String?       @db.Text
  curatorOverviewPt   String?       @db.Text
  curatorOverviewJp   String?       @db.Text
  curatorOverviewJpEn String?       @db.Text
  // Música icônica do personagem
  musicYoutubeId      String?
  musicTitle          String?
  musicArtist         String?
  musicStatus         String?       @default("pending_review") // pending_review | approved
  curationStatus      String?       @default("pending_review") // pending_review | approved
  curationNotes       String?       @db.Text
  franchise           Franchise          @relation(fields: [franchiseId], references: [id])
  bios               FighterBio[]
  chronicleLinks     FighterChronicleLink[]
  collectibles       Collectible[]
  tips               FighterTip[]
  moves              FighterMove[]
  suggestions        FighterSuggestion[]

  @@index([franchiseId])
}

// Descrições de movimentos/Final Smash por era (fichas SMASH do SSBWiki / smashwiki.info).
// Ex.: "[DX] マリオ(SMASH)", "[X] マリオファイナル". Múltiplas por era.
model FighterMove {
  id               String  @id @default(cuid())
  fighterId        String
  smashGameVersion String  // SSB64 | SSBM | SSBB | SSB4 | SSBU
  order            Int     @default(0)
  label            String? // rótulo do tipo: "SMASH", "Final Smash", "EX"
  descEn           String? @db.Text
  descJp           String? @db.Text
  descPt           String? @db.Text
  descJpEn         String? @db.Text
  fighter          Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  @@index([fighterId, smashGameVersion])
}

model FighterBio {
  id                  String  @id @default(cuid())
  fighterId           String
  smashGameVersion    String
  contentEn           String  @db.Text
  contentPt           String? @db.Text
  contentJp           String? @db.Text
  contentJpTranslated String? @db.Text  // deprecated — mantido para compat
  contentJpEn         String? @db.Text
  
  // Timestamps do vídeo de perfil (ex: Smash 64 Profiles, Melee ZoomZike, etc)
  videoStartSec       Int?
  videoEndSec         Int?

  fighter             Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  @@unique([fighterId, smashGameVersion])
}

model Collectible {
  id               String   @id @default(cuid())
  fighterId        String?
  type             String
  smashGameVersion String
  name             String
  nameJp           String?
  description      String?  @db.Text   // legacy — mantido para compat
  descriptionNa    String?  @db.Text
  descriptionEu    String?  @db.Text
  descriptionEn    String?  @db.Text
  descriptionPt    String?  @db.Text
  descriptionJp    String?  @db.Text
  descriptionJpEn  String?  @db.Text
  sourceType       String   @default("Official")
  sourceGame       String?  // Jogo de origem do coletável (ex: "Super Mario Bros.", "F-Zero")
  assetRenderUrl   String?
  assetRender2Url  String?  // Imagem secundária (ex: versão 3DS para troféus SSB4 Both)
  orderIndex       Int?     // Número oficial da galeria/spirit board (legado genérico)
  posicaoTrofeuMelee Int?
  posicaoTrofeuBrawl Int?
  posicaoTrofeuSsb4  Int?
  posicaoSpiritSsbu  Int?
  // Timestamps do vídeo de galeria
  videoStartSec      Int?
  videoEndSec        Int?
  curationStatus     String   @default("pending_review")
  // Spirit metadata (fonte: ssbuspirits.com)
  spiritFirstAppearance String?       // Jogo de primeira aparição do personagem, ex: "EarthBound (1994)"
  spiritArtworkSource   String?       // Jogo de origem da artwork do spirit, ex: "Mario Party 10 (2015)"
  spiritMusicTitle      String?       // Música associada, ex: "Bein' Friends"
  spiritMusicArtist     String?       // Artista/arranjador, ex: "Shogo Sakai"
  spiritMusicDuration   String?       // Duração, ex: "02:03"
  spiritCuratorComment  String?       @db.Text // Texto curatorial de fã (ssbuspirits.com)
  franchiseId      String?
  fighter          Fighter?   @relation(fields: [fighterId], references: [id], onDelete: SetNull)
  franchise        Franchise? @relation("CollectibleFranchise", fields: [franchiseId], references: [id])
  relationsFrom    CollectibleRelation[] @relation("RelFrom")
  relationsTo      CollectibleRelation[] @relation("RelTo")
  chronicleLinks   CollectibleChronicleLink[]

  @@index([type, smashGameVersion])
  @@index([franchiseId])
}

model CollectibleRelation {
  id           String      @id @default(cuid())
  fromId       String
  toId         String
  relationType String      // "cross_game" | "fighter_link"
  from         Collectible @relation("RelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to           Collectible @relation("RelTo",   fields: [toId],   references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
}

model Stage {
  id                String     @id @default(cuid())
  name              String     @unique
  franchiseId       String
  smashDebutVersion String
  description       String?    @db.Text
  franchise         Franchise  @relation(fields: [franchiseId], references: [id])
  defaultTracks     StageMusic[]
}

model Music {
  id              String     @id @default(cuid())
  title           String
  franchiseId     String
  arranger        String?
  isRemix         Boolean    @default(false)
  // SSBWiki SSBU data (adicionado Sessão 22):
  youtubeId       String?    // ID do vídeo YouTube (extraído do link da wiki)
  duration        String?    // "MM:SS"
  sourceGame      String?    // jogo de origem (ex: "Super Mario Bros.")
  compositionType String?    // "Original", "New Remix", "Melee Remix", "SSB4 Remix", etc.
  notes           String?    // texto de Notes da wiki (arrangers, supervisors, etc.)
  franchise       Franchise  @relation(fields: [franchiseId], references: [id])
  stages          StageMusic[]

  @@index([franchiseId])
}

model StageMusic {
  stageId String
  musicId String
  stage   Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  music   Music @relation(fields: [musicId], references: [id], onDelete: Cascade)

  @@id([stageId, musicId])
}

model FighterTip {
  id          String   @id @default(cuid())
  fighterId   String
  titleEn     String
  textEn      String   @db.Text
  titlePt     String?
  textPt      String?  @db.Text
  titleJp     String?
  textJp      String?  @db.Text
  titleJpEn   String?
  textJpEn    String?  @db.Text
  fighter     Fighter  @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  @@index([fighterId])
}

model FighterSuggestion {
  id          String   @id @default(cuid())
  fighterId   String
  section     String   // ex: "SSB64" | "SSBM" | "SSBB" | "SSB4" | "SSBU" | "general"
  authorName  String
  message     String   @db.Text
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  fighter     Fighter  @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  @@index([fighterId, section])
}

model ChronicleEntry {
  id              String   @id @default(cuid())
  consoleName     String   // ex: "Nintendo 64"
  titleNtsc       String   // ex: "Star Fox 64" (Ou "JP EXCLUSIVE")
  titlePal        String?  // ex: "Lylat Wars"
  titleJp         String?  // ex: "Star Fox 64" (Japonês)
  titleJpEn       String?
  titleJpPt       String?
  releaseDateNtsc String?  // Strings pois formatos variam (ex: "1982" ou "1989/07/27")
  releaseDatePal  String?
  releaseDateJp   String?
  unlockCriteria  String?  @db.Text
  wikiUrl         String?  // URL de referência usada para o merge
  wikiUrlJp       String?  // URL de referência JP (Wikipedia japonesa)
  boxArtUrl       String?  // Capa oficial do jogo retirada do SmashWiki
  boxArtUrlJp     String?  // Capa da edição JP
  collectibleLinks CollectibleChronicleLink[]
  fighterLinks     FighterChronicleLink[]

  @@index([consoleName])
}

// Works dos lutadores — jogos de origem ligados DIRETAMENTE ao Chronicles.
// Fonte única de verdade: ChronicleEntry (capa, wiki, console, datas, títulos JP).
model FighterChronicleLink {
  fighterId        String
  chronicleEntryId String
  isDebut          Boolean @default(false)
  displayOrder     Int?
  fighter          Fighter        @relation(fields: [fighterId],        references: [id], onDelete: Cascade)
  chronicleEntry   ChronicleEntry @relation(fields: [chronicleEntryId], references: [id], onDelete: Cascade)

  @@id([fighterId, chronicleEntryId])
  @@index([fighterId])
  @@index([chronicleEntryId])
}

model CollectibleChronicleLink {
  collectibleId    String
  chronicleEntryId String
  collectible      Collectible    @relation(fields: [collectibleId],    references: [id], onDelete: Cascade)
  chronicleEntry   ChronicleEntry @relation(fields: [chronicleEntryId], references: [id], onDelete: Cascade)

  @@id([collectibleId, chronicleEntryId])
  @@index([collectibleId])
  @@index([chronicleEntryId])
}
